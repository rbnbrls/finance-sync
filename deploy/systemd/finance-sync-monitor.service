[Unit]
Description=finance-sync health monitor (one-shot check)
# Requires network (health endpoints, Coolify API, GitHub API) and docker
# (container resource stats).  The unit is intentionally a one-shot; the
# timer drives the cadence.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# The monitor is installed as the `finance-sync-monitor` console script of
# the finance-sync package (see pyproject.toml [project.scripts]).
ExecStart=/usr/local/bin/finance-sync-monitor
# Tokens come ONLY from the environment.  Create this file (chmod 600) with:
#   COOLIFY_API_TOKEN=...
#   GITHUB_TOKEN=...
# Optional overrides:
#   STATE_FILE=/var/lib/finance-sync/finance-sync-monitor-state.json
#   COOLIFY_API_URL=http://192.168.3.110:8000/api/v1
#   COOLIFY_APP_NAME=finance-sync-production
#   COOLIFY_APP_UUID=<uuid>          explicit override, still checked against
#                                    the provider unless the URL is pinned too
#   MONITOR_HEALTH_BASE_URL=https://prod-finance-sync.7rb.nl
# No application UUID is configured here: the monitor resolves the monitored
# application from the Coolify API by name on every run (and probes the route
# Coolify serves for it), so recreating the application needs no change to
# this unit.
EnvironmentFile=/etc/finance-sync/finance-sync-monitor.env
# State file default lives in /var/lib/finance-sync (created on first run).
# If STATE_FILE is overridden, adjust StateDirectory accordingly.
StateDirectory=finance-sync
# Exit code 1 means GitHub issue creation failed; exit code 2 means the target
# application could not be resolved (a typed `error:<reason>` on stderr, e.g.
# error:coolify_application_not_found:finance-sync-production).  systemd
# records either in the unit state but the timer keeps running.
Restart=no

[Install]
WantedBy=multi-user.target
