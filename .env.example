# ==============================================================================
# finance-sync — Environment Variables Reference
# ==============================================================================
# Copy this file to .env and fill in all values before running the application.
#
#   cp .env.example .env
#
# ── Runtime Environment ────────────────────────────────────────────────────────────

# Deployment environment: dev, staging, prod
# Controls debug mode, JSON logging, etc.
# Default: dev
# APP_ENVIRONMENT=prod

# ── Application ────────────────────────────────────────────────────────────────────

# Application name (used in OpenAPI title)
# APP_NAME=finance-sync

# Application version
# APP_VERSION=0.1.0

# Enable debug mode (overridden by APP_ENVIRONMENT in dev/staging)
# DEBUG=false

# ── Logging ────────────────────────────────────────────────────────────────────────

# Minimum log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ── GlitchTip / privacy-first error monitoring ─────────────────────────────────────

# Disabled unless explicitly enabled and a DSN is supplied.
# GLITCHTIP_ENABLED=false
# GLITCHTIP_DSN=
# Error events are sent at this rate; keep tracing lower in production.
# GLITCHTIP_SAMPLE_RATE=1.0
# GLITCHTIP_TRACES_SAMPLE_RATE=0.01
# Defaults to APP_VERSION when empty.
# GLITCHTIP_RELEASE=
# Maximum safe breadcrumbs retained per event.
# GLITCHTIP_MAX_BREADCRUMBS=20

# ── CORS ───────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (default: *)
# JSON list of browser origins; keep empty unless a browser client is used.
# CORS_ORIGINS=["https://finance.example.com"]
# JSON list of reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# TRUSTED_PROXY_IPS=["127.0.0.1","10.0.0.0/8"]
# DEGIRO_IMPORT_MAX_BATCH_BYTES=104857600

# Securo exporter / local test instance
# EXPORTER_SECURO_ENABLED=true
# SECURO_SERVER_URL=http://localhost:3001
# SECURO_EMAIL=
# SECURO_PASSWORD=
# SECURO_OUTPUT_DIR=/tmp/finance_sync_securo_exports
# SECURO_AUTO_CREATE_ACCOUNTS=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────

# Database connection string (alternative to individual POSTGRES_* vars)
# If set, takes precedence over POSTGRES_* variables below.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# DATABASE_URL=postgresql+asyncpg://finance_sync:change-me@localhost:5432/finance_sync

# Individual database settings (used when DATABASE_URL is not set)
POSTGRES_DB=finance_sync
POSTGRES_USER=finance_sync
# REQUIRED: Database password
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Connection pool sizing
# DATABASE_POOL_MIN_SIZE=2
# DATABASE_POOL_MAX_SIZE=10

# Migration user (DDL-only for Alembic — run scripts/setup-migration-user.sql once)
# ASYNC_DB_URL=postgresql+asyncpg://finance_sync_migration:change-me-to-a-strong-password@localhost:5432/finance_sync

# ── Redis ──────────────────────────────────────────────────────────────────────────

# Redis connection string (alternative to individual REDIS_* vars)
# Format: redis://[[username]:[password]]@host:port/db
# REDIS_URL=redis://:password@localhost:6379/0

# Redis password (used when REDIS_URL is not set — assumes localhost:6379/0)
# REDIS_PASSWORD=

# ── Security / JWT ─────────────────────────────────────────────────────────────────

# REQUIRED: Secret key for JWT signing. Must be at least 16 characters.
# Generate with: openssl rand -hex 32
# Generate a unique value; the old placeholder is rejected in production.
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars

# Access token lifetime (minutes)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime (days)
# REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT signing algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# REQUIRED when DATABASE_URL is configured. Exactly 32 characters; this is
# the only first-run admin credential (no email/password bootstrap).
# Generate with: ./scripts/generate-admin-key.sh
# ADMIN_KEY=

# ── Credential Encryption ──────────────────────────────────────────────────────────

# REQUIRED if you plan to store provider credentials (e.g. Plaid, Yodlee, bunq).
# Hex-encoded 32-byte AES-256-GCM master key.
# Generate with: openssl rand -hex 32
# MASTER_ENCRYPTION_KEY=

# ── MCP Server ──────────────────────────────────────────────────────────

# Host/port for the MCP SSE server (Model Context Protocol).
# MCP_PORT=8100
# MCP_HOST=0.0.0.0

# ── Connectors: bunq ────────────────────────────────────────────────────────
# Obtain from the bunq app: Profile → Security → API keys
# BUNQ_API_KEY=
#
# bunq API base URL (optional — defaults to https://api.bunq.com/v1)
# Override with "https://sandbox.bunq.com/v1" for sandbox testing.
# BUNQ_API_BASE_URL=https://api.bunq.com/v1

# ── Exporters: feature flags ────────────────────────────────────────────────
# Per-exporter kill switches (roadmap dr.3). Toggling a flag disables that
# exporter's API surface (exporter type listing, config/export endpoints)
# and CLI commands without a code change.
#
# Default: true (both exporters ship enabled, matching historical behaviour;
# the Actual Budget R1 CLI triggers landed in PR #201).
# EXPORTER_ACTUAL_BUDGET_ENABLED=true
# EXPORTER_WEALTHFOLIO_ENABLED=true
# WEALTHFOLIO_HOLDINGS_STRATEGY=reconcile
# WEALTHFOLIO_RECONCILIATION_ABSOLUTE_TOLERANCE=1.00
# WEALTHFOLIO_RECONCILIATION_PERCENTAGE_TOLERANCE=0.005

# Ghostfolio destination (local stack: docker-compose.ghostfolio.yml)
# EXPORTER_GHOSTFOLIO_ENABLED=true
# GHOSTFOLIO_SERVER_URL=http://localhost:3333
# GHOSTFOLIO_ACCESS_TOKEN=
# GHOSTFOLIO_VERIFY_SSL=true
# GHOSTFOLIO_REQUEST_TIMEOUT=60
# GHOSTFOLIO_DATA_SOURCE=YAHOO
# GHOSTFOLIO_INCLUDE_PENDING=false

# InvestBrain destination (local stack: docker-compose.investbrain.yml)
EXPORTER_INVESTBRAIN_ENABLED=true
INVESTBRAIN_SERVER_URL=http://localhost:18001
INVESTBRAIN_ACCESS_TOKEN=
INVESTBRAIN_VERIFY_SSL=true
INVESTBRAIN_REQUEST_TIMEOUT=60
INVESTBRAIN_INCLUDE_PENDING=false
INVESTBRAIN_PORTFOLIO_NAME_PREFIX=finance-sync

# ── Health monitor (finance-sync-monitor) ────────────────────────────────
# The standalone health monitor (src/finance_sync/monitoring/health_monitor.py,
# scheduled via deploy/systemd/finance-sync-monitor.timer — NOT Hermes cron)
# reads everything from the environment.  No ~/.hermes fallbacks exist.
#
# REQUIRED: Coolify API token (Bearer) for the application status / restart
# count check.  Without it check_coolify_app() reports an error status.
# COOLIFY_API_TOKEN=
#
# REQUIRED for filing GitHub issues on crashes / resource alerts.  Without
# it the monitor still checks health but never creates issues.
# GITHUB_TOKEN=
#
# State file location (JSON, created on first run, parent dir auto-made).
# Default: /var/lib/finance-sync/finance-sync-monitor-state.json
# STATE_FILE=/var/lib/finance-sync/finance-sync-monitor-state.json
#
# Optional overrides (defaults match the current deployment):
# COOLIFY_API_URL=http://192.168.3.110:8000/api/v1
# COOLIFY_APP_UUID=obcopz3142hxzs1zlie78amh
# MONITOR_HEALTH_BASE_URL=https://obcopz3142hxzs1zlie78amh.7rb.nl
